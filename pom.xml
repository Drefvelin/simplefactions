<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.tfminecraft</groupId>
    <artifactId>simplefactions</artifactId>
    <version>2.8.6</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Same layout as Workspace/armourshop -->
        <tfmc.refs>D:/Documents/TFMC/ReferenceLibs</tfmc.refs>
        <tfmc.builds>D:/Documents/TFMC/Builds/SimpleFactions</tfmc.builds>
        <tfmc.tlibs>D:/Documents/TFMC/Builds/TLibs</tfmc.tlibs>
        <tfmc.plugins>D:/Documents/TFMC/Workspace/plugins</tfmc.plugins>
    </properties>

    <dependencies>
        <dependency>
            <groupId>local</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/json-simple-1.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>BungeeCord</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/BungeeCord.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>MMOItems</artifactId>
            <version>6.10</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/MMOItems-6.10.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>MythicLib</artifactId>
            <version>1.7</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/MythicLib-1.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.8</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/spigot-api.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>TLibs</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${tfmc.tlibs}/TLibs.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>DenarEconomy</artifactId>
            <version>0.1.7</version>
            <scope>system</scope>
            <systemPath>${tfmc.plugins}/denareconomy-0.1.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>Warbands</artifactId>
            <version>0.2.2</version>
            <scope>system</scope>
            <systemPath>${tfmc.plugins}/warbands-0.2.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${tfmc.builds}"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                    tofile="${tfmc.builds}/${project.build.finalName}.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
